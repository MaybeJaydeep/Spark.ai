{
  "theme": "dark_professional",
  "window_size": {
    "width": 1400,
    "height": 900,
    "min_width": 1200,
    "min_height": 800
  },
  "layout": {
    "sidebar_width": 280,
    "status_bar_height": 30,
    "card_spacing": 20,
    "section_padding": 24
  },
  "features": {
    "animations_enabled": true,
    "auto_save_settings": true,
    "remember_window_position": true,
    "show_performance_metrics": true,
    "enable_keyboard_shortcuts": true,
    "show_tooltips": true
  },
  "voice_settings": {
    "tts_enabled": true,
    "wake_word_enabled": false,
    "wake_word_sensitivity": 0.6,
    "voice_feedback": true
  },
  "analytics": {
    "enabled": true,
    "track_usage": true,
    "performance_monitoring": true,
    "data_retention_days": 30
  },
  "accessibility": {
    "high_contrast": false,
    "large_fonts": false,
    "keyboard_navigation": true,
    "screen_reader_support": true
  },
  "advanced": {
    "debug_mode": false,
    "log_level": "INFO",
    "auto_update_charts": true,
    "chart_update_interval": 2000,
    "max_activity_items": 100
  }
}